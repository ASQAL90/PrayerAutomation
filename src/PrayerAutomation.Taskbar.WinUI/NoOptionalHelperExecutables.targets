<Project>
  <!-- These optional SDK/runtime helper EXEs are not used by the island renderer.
       No restart API, crash-dump API, or package-deployment API is exposed/called. -->
  <Target Name="ExcludeOptionalAwqatHelperExecutables" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'RestartAgent.exe' Or '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'createdump.exe'" />
    </ItemGroup>
  </Target>
</Project>
