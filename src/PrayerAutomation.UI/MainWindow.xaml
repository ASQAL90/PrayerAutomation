<Window x:Class="PrayerAutomation.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PrayerAutomation.UI"
        Title="{x:Static local:AppBranding.WindowTitle}" Width="1180" Height="820"
        MinWidth="1180" MinHeight="820" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="CorrectionHelperButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="25" />
            <Setter Property="MinWidth" Value="25" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="3" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="SelectionTextBrush" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="3" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="CalendarYearItem" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="3,4,3,8" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        </Style>
        <Style x:Key="CardGroup" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        </Style>
        <Style x:Key="FormBodyText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style x:Key="FormCheckBoxText" TargetType="TextBlock" BasedOn="{StaticResource FormBodyText}">
            <Setter Property="Margin" Value="14,0,0,0" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type CheckBox}}}" />
        </Style>
        <Style x:Key="FormHelpText" TargetType="TextBlock" BasedOn="{StaticResource FormBodyText}">
            <Setter Property="Margin" Value="3,4,3,8" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource FormBodyText}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="3,4,12,6" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style x:Key="SettingsActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="CalendarDayButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="1" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Focusable" Value="True" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tekstur latar: siluet masjid besar di sudut kanan atas, di belakang konten. -->
        <Viewbox Grid.RowSpan="3" Width="380" Height="380" Margin="0,-26,-44,0"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 IsHitTestVisible="False" Focusable="False">
            <Viewbox.OpacityMask>
                <LinearGradientBrush StartPoint="0,0.171" EndPoint="0,0.566">
                    <GradientStop Offset="0" Color="#FFFFFFFF" />
                    <GradientStop Offset="1" Color="#00FFFFFF" />
                </LinearGradientBrush>
            </Viewbox.OpacityMask>
            <Canvas Width="100" Height="100">
                <Path Data="{x:Static local:AppBranding.MosqueGeometry}" Fill="{DynamicResource WatermarkBrush}" />
            </Canvas>
        </Viewbox>

        <Grid Grid.Row="0" Margin="18,14,18,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <local:AppLogo Width="42" Height="42" Margin="0,0,10,0" AutomationProperties.AutomationId="ApplicationLogo" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Static local:AppBranding.DisplayName}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Jadwal sholat, kalender, dan pengingat" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Name="ClockLabel" AutomationProperties.AutomationId="ClockLabel" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Content="Keluar" Click="Exit_Click" />
            </StackPanel>
        </Grid>

        <TabControl Name="MainTabs" Grid.Row="1" Margin="14,6,14,8" Background="Transparent" SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="Ringkasan" AutomationProperties.AutomationId="OverviewTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16">
                        <Border Name="KhgtOfferPanel" AutomationProperties.AutomationId="KhgtOfferPanel" Visibility="Collapsed"
                                Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1" CornerRadius="{DynamicResource CardCornerRadius}" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Kalender Hijriyah Muhammadiyah" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource FormHelpText}" TextWrapping="Wrap"
                                           Text="Muhammadiyah memakai KHGT sejak 1 Muharram 1447 H. Aplikasi bisa memakai tabel resmi KHGT 1440–1499 H sebagai perkiraan, dengan koreksi manual tetap tersedia. Pakai sekarang?"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <WrapPanel Margin="0,2,0,0">
                                    <Button Content="Pakai KHGT (perkiraan)" AutomationProperties.AutomationId="KhgtOfferAcceptButton" Style="{StaticResource SettingsActionButton}" Click="KhgtOfferAccept_Click" />
                                    <Button Content="Tetap sipil" AutomationProperties.AutomationId="KhgtOfferDeclineButton" Style="{StaticResource SettingsActionButton}" Click="KhgtOfferDecline_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Name="TodayLabel" AutomationProperties.AutomationId="TodayLabel" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Name="LocationSummary" AutomationProperties.AutomationId="LocationSummary" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CardCornerRadius}" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Jadwal hari ini" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <Grid Name="ScheduleOverviewGrid" AutomationProperties.AutomationId="ScheduleOverviewGrid">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <GroupBox Header="Standar perhitungan" Style="{StaticResource CardGroup}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Name="OverviewMethodLabel" AutomationProperties.AutomationId="OverviewMethodLabel" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource FormHelpText}" Name="OverviewCalculationNote" Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Status aplikasi" Style="{StaticResource CardGroup}">
                            <StackPanel>
                                <TextBlock Name="OverviewReminderStatus" AutomationProperties.AutomationId="OverviewReminderStatus" />
                                <TextBlock Style="{StaticResource FormHelpText}" Name="OverviewCalendarStatus" AutomationProperties.AutomationId="OverviewCalendarStatus" Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Name="CalendarTab" Header="Kalender" AutomationProperties.AutomationId="CalendarTab">
                <Grid Margin="10">
                    <TabControl Name="CalendarModeTabs">
                        <TabItem Header="Masehi / Gregorian" AutomationProperties.AutomationId="GregorianCalendarTab">
                            <Grid Margin="10">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Kalender tahunan Masehi" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource FormHelpText}" Text="Klik tanggal untuk melihat padanan Hijriyah dan penandanya." Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Name="PreviousCalendarYearButton" AutomationProperties.AutomationId="PreviousGregorianYearButton" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.Name="Tahun Masehi sebelumnya" Content="‹" Width="34" Click="PreviousGregorianYear_Click" />
                                        <ComboBox Name="CalendarYearBox" AutomationProperties.AutomationId="CalendarYearBox" Width="100" Margin="3" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ItemContainerStyle="{StaticResource CalendarYearItem}" IsEditable="False" SelectionChanged="CalendarYearBox_SelectionChanged" ToolTip="Pilih tahun; kalender langsung dimuat." />
                                        <Button Name="NextCalendarYearButton" AutomationProperties.AutomationId="NextGregorianYearButton" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.Name="Tahun Masehi berikutnya" Content="›" Width="34" Click="NextGregorianYear_Click" />
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" Name="SelectedDatePanel" AutomationProperties.AutomationId="SelectedDatePanel" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CardCornerRadius}" Padding="10" Margin="0,0,0,6" Height="92">
                                    <TextBlock Style="{StaticResource FormHelpText}" Name="SelectedDateDetail" AutomationProperties.AutomationId="SelectedDateDetail" Text="Pilih tanggal untuk melihat detail." Margin="0,0,10,0" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Row="2" Margin="2,0,2,6">
                                    <WrapPanel Name="GregorianCalendarLegend" AutomationProperties.AutomationId="GregorianCalendarLegend">
                                        <StackPanel Orientation="Horizontal" Margin="2,1,10,1"><Grid Width="16" Height="16" Margin="0,0,5,0"><Rectangle Width="16" Height="16" RadiusX="3" RadiusY="3" Fill="{DynamicResource ErrorTextBrush}" Stroke="{DynamicResource AppBorderBrush}" /><Path Data="M8,2.6 L9.7,6 L13.4,6.4 L10.6,8.9 L11.4,12.5 L8,10.6 L4.6,12.5 L5.4,8.9 L2.6,6.4 L6.3,6 Z" Fill="#FFFFFF" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid><TextBlock Text="Hari libur / Id" FontSize="11" /></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="2,1,10,1"><Grid Width="16" Height="16" Margin="0,0,5,0"><Rectangle Width="16" Height="16" RadiusX="3" RadiusY="3" Fill="{DynamicResource SuccessTextBrush}" Stroke="{DynamicResource AppBorderBrush}" /><Ellipse Width="6.5" Height="6.5" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid><TextBlock Text="Puasa sunnah" FontSize="11" /></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="2,1,10,1"><Grid Width="16" Height="16" Margin="0,0,5,0"><Rectangle Width="16" Height="16" RadiusX="3" RadiusY="3" Fill="{DynamicResource WarningTextBrush}" Stroke="{DynamicResource AppBorderBrush}" /><Path Data="M5.4,5.4 L10.6,10.6 M10.6,5.4 L5.4,10.6" Stroke="#FFFFFF" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="6.5" Height="6.5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid><TextBlock Text="Larangan puasa / Tasyrik" FontSize="11" /></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="2,1,10,1"><Grid Width="16" Height="16" Margin="0,0,5,0"><Rectangle Width="16" Height="16" RadiusX="3" RadiusY="3" Fill="{DynamicResource NoteTextBrush}" Stroke="{DynamicResource AppBorderBrush}" /><Path Data="M8,3.6 L12.4,8 L8,12.4 L3.6,8 Z" Fill="#FFFFFF" Width="8.8" Height="8.8" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid><TextBlock Text="Peringatan Islam" FontSize="11" /></StackPanel>
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource FormHelpText}" Name="GregorianCalendarNote" AutomationProperties.AutomationId="GregorianCalendarNote" Text="Perkiraan kalender sipil, bukan penetapan resmi. Ikuti hasil rukyat atau otoritas setempat." Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <UniformGrid Name="CalendarGrid" AutomationProperties.AutomationId="CalendarGrid" Columns="3" />
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Hijriyah" AutomationProperties.AutomationId="HijriCalendarTab">
                            <Grid Margin="10">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Kalender Hijriyah tahunan" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource FormHelpText}" Text="Menampilkan 12 bulan Muharram–Zulhijah dan padanan tanggal Masehi." Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Name="PreviousHijriYearButton" AutomationProperties.AutomationId="PreviousHijriYearButton" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.Name="Tahun Hijriyah sebelumnya" Content="‹" Width="34" Click="PreviousHijriYear_Click" />
                                        <ComboBox Name="HijriYearBox" AutomationProperties.AutomationId="HijriYearBox" Width="100" Margin="3" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ItemContainerStyle="{StaticResource CalendarYearItem}" IsEditable="False" SelectionChanged="HijriYearBox_SelectionChanged" ToolTip="Pilih tahun; kalender langsung dimuat." />
                                        <Button Name="NextHijriYearButton" AutomationProperties.AutomationId="NextHijriYearButton" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.Name="Tahun Hijriyah berikutnya" Content="›" Width="34" Click="NextHijriYear_Click" />
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CardCornerRadius}" Padding="8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <Grid Margin="2,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Sumber kalender" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MutedTextBrush}" />
                                            <ComboBox Grid.Column="1" Name="HijriSourceBox" AutomationProperties.AutomationId="HijriSourceBox" VerticalAlignment="Center" VerticalContentAlignment="Center" MinWidth="160" MinHeight="30" SelectionChanged="HijriSourceBox_SelectionChanged" ToolTip="Tabel resmi KHGT Muhammadiyah 1440–1499 H tersimpan offline. Di luar rentang itu aplikasi memakai kalender sipil/tabular, sehingga label tetap “KHGT (perkiraan)”.">
                                                <ComboBoxItem Content="Sipil/tabular" Tag="civil" />
                                                <ComboBoxItem Content="KHGT (perkiraan)" Tag="khgt" />
                                            </ComboBox>
                                        </Grid>
                                        <TextBlock Style="{StaticResource FormHelpText}" Name="HijriYearLabel" AutomationProperties.AutomationId="HijriYearLabel" Text="Pilih tahun Hijriyah; kalender langsung dimuat." />
                                        <WrapPanel Name="HijriCalendarLegend" AutomationProperties.AutomationId="HijriCalendarLegend" Margin="0,3,0,0">
                                            <StackPanel Orientation="Horizontal" Margin="2,1,10,1"><Grid Width="16" Height="16" Margin="0,0,5,0"><Rectangle Width="16" Height="16" RadiusX="3" RadiusY="3" Fill="{DynamicResource ErrorTextBrush}" Stroke="{DynamicResource AppBorderBrush}" /><Path Data="M8,2.6 L9.7,6 L13.4,6.4 L10.6,8.9 L11.4,12.5 L8,10.6 L4.6,12.5 L5.4,8.9 L2.6,6.4 L6.3,6 Z" Fill="#FFFFFF" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid><TextBlock Text="Hari besar / Id" FontSize="11" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="2,1,10,1"><Grid Width="16" Height="16" Margin="0,0,5,0"><Rectangle Width="16" Height="16" RadiusX="3" RadiusY="3" Fill="{DynamicResource SuccessTextBrush}" Stroke="{DynamicResource AppBorderBrush}" /><Ellipse Width="6.5" Height="6.5" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid><TextBlock Text="Puasa sunnah" FontSize="11" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="2,1,10,1"><Grid Width="16" Height="16" Margin="0,0,5,0"><Rectangle Width="16" Height="16" RadiusX="3" RadiusY="3" Fill="{DynamicResource WarningTextBrush}" Stroke="{DynamicResource AppBorderBrush}" /><Path Data="M5.4,5.4 L10.6,10.6 M10.6,5.4 L5.4,10.6" Stroke="#FFFFFF" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="6.5" Height="6.5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid><TextBlock Text="Tasyrik / larangan puasa" FontSize="11" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="2,1,10,1"><Grid Width="16" Height="16" Margin="0,0,5,0"><Rectangle Width="16" Height="16" RadiusX="3" RadiusY="3" Fill="{DynamicResource NoteTextBrush}" Stroke="{DynamicResource AppBorderBrush}" /><Path Data="M8,3.6 L12.4,8 L8,12.4 L3.6,8 Z" Fill="#FFFFFF" Width="8.8" Height="8.8" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid><TextBlock Text="Peringatan" FontSize="11" /></StackPanel>
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource FormHelpText}" Name="HijriCalendarNote" AutomationProperties.AutomationId="HijriCalendarNote" Text="Catatan sumber kalender dimuat bersama tahun Hijriyah." Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CardCornerRadius}" Padding="8" Margin="0,0,0,6" Height="72">
                                    <TextBlock Style="{StaticResource FormHelpText}" Name="HijriSelectedDateDetail" AutomationProperties.AutomationId="HijriSelectedDateDetail" Text="Pilih tanggal Hijriyah untuk melihat padanan Masehi." Margin="0,0,10,0" VerticalAlignment="Center" />
                                </Border>
                                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <UniformGrid Name="HijriCalendarGrid" AutomationProperties.AutomationId="HijriCalendarGrid" Columns="3" />
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <TabItem Header="Pengaturan" AutomationProperties.AutomationId="SettingsTab">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <GroupBox Header="Estimasi waktu sholat hari ini" Style="{StaticResource CardGroup}" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Style="{StaticResource FormHelpText}" Name="SettingsScheduleDateLabel" AutomationProperties.AutomationId="SettingsScheduleDateLabel" Text="Perkiraan dari lokasi, zona waktu, metode, dan koreksi form." Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Style="{StaticResource FormHelpText}" Name="SettingsScheduleHijriDateLabel" AutomationProperties.AutomationId="SettingsScheduleHijriDateLabel" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Text="Geser tanggal Hijriyah" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <StackPanel Grid.Row="1" Grid.Column="4" Name="HijriDateCorrectionHost" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid Name="SettingsSchedulePreviewGrid" AutomationProperties.AutomationId="SettingsSchedulePreviewGrid">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    </Grid>
                                    <TextBlock Style="{StaticResource FormHelpText}" Name="SettingsSchedulePreviewStatus" AutomationProperties.AutomationId="SettingsSchedulePreviewStatus" Margin="3,12,3,8" MinHeight="40" Text="Perkiraan aplikasi, bukan jadwal resmi." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Lokasi dan standar perhitungan" Style="{StaticResource CardGroup}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid Margin="0,0,8,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Nama lokasi" />
