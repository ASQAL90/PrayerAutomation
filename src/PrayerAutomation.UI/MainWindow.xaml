                                        <TextBlock Style="{StaticResource FormCheckBoxText}" Text="Kunci Windows saat lima waktu sholat" />
                                    </CheckBox>
                                    <TextBlock Style="{StaticResource FormHelpText}" Text="Default nonaktif. Mengunci sesi pada Subuh, Dzuhur, Ashar, Maghrib, dan Isya. Terpisah dari pengingat teks dan tidak mengubah gambar lock screen. Tanpa hak administrator." Foreground="{DynamicResource MutedTextBrush}" />
                                    <CheckBox Name="LockScreenCheckBox" AutomationProperties.AutomationId="LockScreenCheckBox" IsEnabled="False" >
                                        <TextBlock Style="{StaticResource FormCheckBoxText}" Text="Saya setuju mengubah gambar lock screen sementara" />
                                    </CheckBox>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Style="{StaticResource FormHelpText}" Text="Pratinjau gambar saat waktu sholat (klik untuk memperbesar):" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                                            <Border BorderBrush="{DynamicResource MutedTextBrush}" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Stretch" Padding="2">
                                                <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch">
                                                    <Image Name="LockScreenPreviewImage" AutomationProperties.AutomationId="LockScreenPreviewImage" AutomationProperties.Name="Pratinjau gambar lock screen sementara" AutomationProperties.HelpText="Klik untuk memperbesar gambar" Stretch="Uniform" Cursor="Hand" ToolTip="Klik untuk memperbesar gambar" MouseLeftButtonUp="LockScreenPreviewImage_MouseLeftButtonUp" />
                                                </Viewbox>
                                            </Border>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <Button Grid.Row="0" Grid.Column="0" Name="LockScreenTestNowButton" Content="Coba gambar sholat (1 menit)" AutomationProperties.AutomationId="LockScreenTestNowButton" Style="{StaticResource SettingsActionButton}" HorizontalAlignment="Stretch" Margin="0,0,3,0" Click="LockScreenTestNow_Click" ToolTip="Pasang gambar sholat selama satu menit, lalu layar langsung dikunci. Setelah itu gambar semula dipulihkan otomatis." />
                                                <Button Grid.Row="0" Grid.Column="1" Name="LockScreenRestoreNowButton" Content="Kembalikan gambar semula" AutomationProperties.AutomationId="LockScreenRestoreNowButton" Style="{StaticResource SettingsActionButton}" HorizontalAlignment="Stretch" Margin="3,0,0,0" Click="LockScreenRestoreNow_Click" ToolTip="Kembalikan gambar dan mode lock screen semula sekarang, tanpa menunggu satu menit." />
                                                <Button Grid.Row="1" Grid.Column="0" Name="LockScreenCancelRecoveryButton" Content="Hentikan pemulihan otomatis" AutomationProperties.AutomationId="LockScreenCancelRecoveryButton" Style="{StaticResource SettingsActionButton}" HorizontalAlignment="Stretch" Margin="0,3,3,0" Visibility="Visible" IsEnabled="False" Click="LockScreenCancelRecovery_Click" ToolTip="Tombol darurat: hapus catatan pemulihan aplikasi dan biarkan gambar saat ini. Jangan dipakai bila gambar masih salah. Tidak menghapus foto atau riwayat Windows." />
                                                <Button Grid.Row="1" Grid.Column="1" Name="LockScreenOptOutButton" Content="Matikan fitur ini di PC ini" AutomationProperties.AutomationId="LockScreenOptOutButton" Style="{StaticResource SettingsActionButton}" HorizontalAlignment="Stretch" Margin="3,3,0,0" Visibility="Collapsed" Click="LockScreenOptOut_Click" ToolTip="Tombol darurat: aplikasi berhenti memasang gambar lock screen. Tidak mengubah kebijakan perangkat atau pengaturan Windows lain." />
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
                                            <Grid Margin="3,0,3,3" HorizontalAlignment="Left">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                                                <TextBlock Name="LockScreenDurationLabel" Text="Lama tampil gambar (menit)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Name="LockScreenDurationBox" AutomationProperties.AutomationId="LockScreenDurationBox" AutomationProperties.Name="Lama tampil gambar lock screen dalam menit" TextAlignment="Center" HorizontalAlignment="Center" Width="70" ToolTip="1–60 menit. Berlaku pada perubahan gambar berikutnya." />
                                            </Grid>
                                            <TextBlock Style="{StaticResource FormHelpText}" Text="1–60 menit; default 15. Dibatasi sisa waktu menuju sholat berikutnya dan berlaku untuk gambar berikutnya." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource FormHelpText}" Text="Gambar dipasang dua menit sebelum waktu sholat memakai jam jadwal. Setelah durasi habis, tampilan semula dikembalikan; jika tidak bisa dipastikan, gambar tidak diubah. Tanpa hak administrator." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                            <StackPanel MinHeight="58" Margin="0,8,0,0">
                                                <TextBlock Style="{StaticResource FormHelpText}" Name="LockScreenSafetyText" Text="Memeriksa syarat pemulihan lock screen..." TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource FormHelpText}" Name="LockScreenStatus" AutomationProperties.AutomationId="LockScreenStatus" Text="Memeriksa profil lock screen Windows..." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource FormHelpText}" Text="Pratinjau memakai renderer yang sama dengan gambar asli. Windows kadang perlu satu kali kunci ulang agar gambar baru terlihat penuh." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Penyimpanan &amp; diagnostik" Style="{StaticResource CardGroup}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FormHelpText}" Name="StorageSummaryText" AutomationProperties.AutomationId="StorageSummaryText" Text="Menghitung pemakaian…" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource FormHelpText}" Text="Log disimpan di folder data pengguna dan dipotong otomatis (2 MB, tiga berkas, disimpan 30 hari). Cache berisi unduhan pembaruan dan gambar lock screen sementara; pengaturan tidak dihapus." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,6" />
                                    <WrapPanel>
                                        <Button Name="OpenDataFolderButton" Content="Buka folder data" AutomationProperties.AutomationId="OpenDataFolderButton" Style="{StaticResource SettingsActionButton}" Click="OpenDataFolder_Click" ToolTip="Membuka folder log, cache, dan pengaturan di Explorer." />
                                        <Button Name="OpenLogButton" Content="Buka log" AutomationProperties.AutomationId="OpenLogButton" Style="{StaticResource SettingsActionButton}" Click="OpenLog_Click" ToolTip="Membuka berkas log terbaru di aplikasi teks bawaan Windows." />
                                        <Button Name="ClearCacheButton" Content="Bersihkan cache &amp; log" AutomationProperties.AutomationId="ClearCacheButton" Style="{StaticResource SettingsActionButton}" Click="ClearCache_Click" ToolTip="Hapus log, unduhan pembaruan, dan gambar lock screen lama. Pengaturan dan jadwal tetap." />
                                        <Button Name="ResetConfigButton" Content="Reset pengaturan awal" AutomationProperties.AutomationId="ResetConfigButton" Style="{StaticResource SettingsActionButton}" Click="ResetConfig_Click" ToolTip="Hapus pengaturan dan cadangannya, lalu kembalikan nilai awal seperti instal baru. Log, unduhan, dan catatan pemulihan lock screen tidak diubah. Perubahan form yang belum disimpan akan dibatalkan." />
                                        <Button Name="ExportDiagnosticsButton" Content="Ekspor diagnostik" AutomationProperties.AutomationId="ExportDiagnosticsButton" Style="{StaticResource SettingsActionButton}" Click="ExportDiagnostics_Click" ToolTip="Simpan laporan berisi versi, ringkasan pengaturan, ukuran berkas, dan cuplikan log yang sudah disanitasi." />
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource FormHelpText}" Name="StorageStatusText" AutomationProperties.AutomationId="StorageStatusText" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Style="{StaticResource FormHelpText}" Grid.Row="1" Name="SettingsStatusLabel" AutomationProperties.AutomationId="SettingsStatusLabel" Foreground="{DynamicResource MutedTextBrush}" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Batalkan perubahan" Click="CancelSettings_Click" />
                        <Button Name="SaveSettingsButton" Content="Simpan pengaturan" AutomationProperties.AutomationId="SaveSettingsButton" Click="SaveSettings_Click" IsDefault="True" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Name="FooterStatus" AutomationProperties.AutomationId="FooterStatus" Text="Aktif di area notifikasi sistem." Foreground="{DynamicResource MutedTextBrush}" Margin="18,0,18,8" />
    </Grid>
</Window>
