<Window x:Class="PrayerAutomation.UI.LocationMapDialog" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pilih lokasi pada peta" Width="760" Height="640" MinWidth="660" MinHeight="580"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="3" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="SelectionTextBrush" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="3,4,3,8" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        </Style>
        <Style x:Key="MapCheckBoxText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="14,0,0,0" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type CheckBox}}}" />
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="19" FontWeight="SemiBold" Text="Pilih titik pada peta"
                   AutomationProperties.AutomationId="LocationMapDialogHeading" Margin="0,0,0,10" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="MapSearchBox" AutomationProperties.AutomationId="MapSearchBox" Margin="0,0,8,0"
                     TextAlignment="Left" VerticalContentAlignment="Center"
                     ToolTip="Cari kota/permukiman dari data lokal. Nominatim opsional bila diaktifkan di Pengaturan."
                     KeyDown="MapSearchBox_KeyDown" />
            <Button Grid.Column="1" x:Name="SearchMapButton" Content="Cari"
                    AutomationProperties.AutomationId="SearchMapButton" Click="SearchMapButton_Click" />
        </Grid>

        <ListBox Grid.Row="2" x:Name="MapSearchResults" AutomationProperties.AutomationId="MapSearchResults"
                 DisplayMemberPath="DisplayName" MaxHeight="118" Margin="0,6,0,0" Visibility="Collapsed"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="MapSearchResults_SelectionChanged" />

        <Border Grid.Row="3" Margin="0,10,0,0" Background="{DynamicResource AppBackgroundBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource CardCornerRadius}">
            <Grid x:Name="MapCanvasHost" ClipToBounds="True" MouseWheel="MapCanvas_MouseWheel">
                <Canvas x:Name="MapCanvas" ClipToBounds="True" Background="Transparent"
                        MouseLeftButtonDown="MapCanvas_MouseLeftButtonDown"
                        MouseMove="MapCanvas_MouseMove"
                        MouseLeftButtonUp="MapCanvas_MouseLeftButtonUp"
                        LostMouseCapture="MapCanvas_LostMouseCapture"
                        SizeChanged="MapCanvas_SizeChanged"
                        AutomationProperties.AutomationId="MapCanvas" Cursor="Cross">
                    <Canvas x:Name="TileLayer" IsHitTestVisible="False" />
                    <Canvas x:Name="GridLayer" IsHitTestVisible="False" />
                    <Ellipse x:Name="MapMarker" Width="14" Height="14" Visibility="Collapsed"
                             Fill="{DynamicResource AccentBrush}" Stroke="{DynamicResource PrimaryTextBrush}"
                             StrokeThickness="1" IsHitTestVisible="False" />
                </Canvas>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="8" Panel.ZIndex="2">
                    <Button x:Name="ZoomOutButton" Content="−" Width="30" Height="30" Padding="0"
                            FontSize="18" FontWeight="SemiBold"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            AutomationProperties.AutomationId="MapZoomOutButton"
                            AutomationProperties.Name="Perkecil peta" Click="ZoomOutButton_Click" />
                    <Border x:Name="ZoomLevelBadge" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                            Height="30" CornerRadius="4" Padding="8,0" Margin="4,0" VerticalAlignment="Center"
                            ToolTip="Persentase pembesaran relatif terhadap zoom awal.">
                        <TextBlock x:Name="ZoomLevelText" Text="100%" MinWidth="46" FontSize="13"
                                   TextAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                    </Border>
                    <Button x:Name="ZoomInButton" Content="+" Width="30" Height="30" Padding="0"
                            FontSize="18" FontWeight="SemiBold"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            AutomationProperties.AutomationId="MapZoomInButton"
                            AutomationProperties.Name="Perbesar peta" Click="ZoomInButton_Click" />
                </StackPanel>
                <Button x:Name="GoToCurrentLocationButton" Width="32" Height="32" Padding="0"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Panel.ZIndex="2"
                        AutomationProperties.AutomationId="GoToCurrentLocationButton"
                        AutomationProperties.Name="Menuju lokasi saat ini"
                        ToolTip="Menuju lokasi saat ini (perangkat/GPS, lalu perkiraan jaringan)"
                        Click="GoToCurrentLocation_Click">
                    <Grid Width="17" Height="17">
                        <Ellipse Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="1.6" />
                        <Path Data="M8.5,0 L8.5,3 M8.5,14 L8.5,17 M0,8.5 L3,8.5 M14,8.5 L17,8.5"
                              Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Ellipse Width="4.5" Height="4.5" Fill="{DynamicResource AccentBrush}" />
                    </Grid>
                </Button>
            </Grid>
        </Border>

        <CheckBox Grid.Row="4" Margin="0,10,0,0"
                  x:Name="MapOnlineConsentCheckBox" AutomationProperties.AutomationId="MapOnlineConsentCheckBox"
                  Checked="MapOnlineConsentCheckBox_Changed" Unchecked="MapOnlineConsentCheckBox_Changed">
            <TextBlock Style="{StaticResource MapCheckBoxText}"
                       Text="Saya setuju memuat tile peta dari OpenStreetMap (menggunakan internet)" />
        </CheckBox>

        <TextBlock Grid.Row="5" x:Name="MapSelectionStatus" AutomationProperties.AutomationId="MapSelectionStatus"
                   Text="Peta dibuka offline. Cari nama tempat atau klik langsung pada peta untuk menetapkan titik sementara."
                   TextWrapping="Wrap" MinHeight="46" Margin="0,8,0,2"
                   Foreground="{DynamicResource MutedTextBrush}" />

        <TextBlock Grid.Row="6" Text="Peta dasar: © OpenStreetMap contributors (ODbL) — https://www.openstreetmap.org/copyright"
                   TextWrapping="Wrap" Margin="0,2,0,8" FontSize="12"
                   Foreground="{DynamicResource MutedTextBrush}" />

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ConfirmMapPointButton" Content="Tetapkan titik" IsEnabled="False"
                    AutomationProperties.AutomationId="ConfirmMapPointButton" Click="ConfirmMapPoint_Click"
                    Margin="0,4,8,0" Padding="12,7" />
            <Button x:Name="CancelMapButton" Content="Batal" IsCancel="True"
                    AutomationProperties.AutomationId="CancelMapButton" Click="CancelMap_Click"
                    Margin="0,4,0,0" Padding="12,7" />
        </StackPanel>
    </Grid>
</Window>
