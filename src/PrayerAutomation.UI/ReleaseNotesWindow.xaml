<Window x:Class="PrayerAutomation.UI.ReleaseNotesWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PrayerAutomation.UI"
        Title="Riwayat perubahan Ayo Jama'ah!" Width="680" Height="640"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Segoe UI"
        UseLayoutRounding="True" PreviewKeyDown="OnPreviewKeyDown">
    <Border BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}"
            Background="{DynamicResource SurfaceBrush}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,14" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <local:AppLogo Width="32" Height="32" Margin="0,0,10,0" />
                    <TextBlock Text="Riwayat perubahan" FontSize="20" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Content="Tutup" Click="OnCloseClick" Padding="10,4"
                        AutomationProperties.AutomationId="ReleaseNotesClose"
                        AutomationProperties.Name="Tutup riwayat perubahan" />
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.AutomationId="ReleaseNotesScroll">
                <ItemsControl Name="NotesList" Margin="0,0,8,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" Margin="{Binding Margin}"
                                       FontWeight="{Binding Weight}" FontSize="13"
                                       LineHeight="18" LineStackingStrategy="BlockLineHeight"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Grid.Row="2" Margin="0,10,0,0" FontSize="12"
                       Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="ReleaseNotesOfflineNote">
                Catatan ini disimpan bersama aplikasi dan dapat dibaca tanpa koneksi internet.
            </TextBlock>
        </Grid>
    </Border>
</Window>
