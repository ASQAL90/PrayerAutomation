<Window x:Class="PrayerAutomation.UI.UpdateWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PrayerAutomation.UI"
        Title="Pembaruan Ayo Jama'ah!" Width="560" Height="620"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Segoe UI"
        UseLayoutRounding="True" PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="UpdateHelpText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
    </Window.Resources>
    <Border BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}"
            Background="{DynamicResource SurfaceBrush}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,14" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <local:AppLogo Width="32" Height="32" Margin="0,0,10,0" />
                    <TextBlock Text="Pembaruan aplikasi" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Content="Tutup" Click="OnCloseClick"
                        AutomationProperties.AutomationId="UpdateCloseButton"
                        AutomationProperties.Name="Tutup jendela pembaruan" />
            </Grid>

            <StackPanel Grid.Row="1">
                <TextBlock Style="{StaticResource UpdateHelpText}" Name="InstalledVersionText"
                           AutomationProperties.AutomationId="UpdateInstalledVersion"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock Style="{StaticResource UpdateHelpText}" Name="StatusText"
                           AutomationProperties.AutomationId="UpdateStatusText"
                           MinHeight="72" Margin="0,8,0,0"
                           TextWrapping="Wrap" VerticalAlignment="Top" />
                <ProgressBar Name="DownloadProgress" Height="6" Minimum="0" Maximum="100"
                             Visibility="Collapsed" Margin="0,8,0,0"
                             AutomationProperties.AutomationId="UpdateProgress" />
                <TextBlock Style="{StaticResource UpdateHelpText}" Name="ProgressText"
                           AutomationProperties.AutomationId="UpdateProgressText"
                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />
                <Border Name="ReleaseNotesPanel" Visibility="Collapsed" Margin="0,12,0,0" Padding="10"
                        BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}"
                        AutomationProperties.AutomationId="UpdateReleaseNotesPanel">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Name="ReleaseNotesTitle" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   AutomationProperties.AutomationId="UpdateReleaseNotesTitle" />
                        <ScrollViewer Grid.Row="1" Name="ReleaseNotesScroll" MaxHeight="180" Margin="0,8,0,0"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      AutomationProperties.AutomationId="UpdateReleaseNotesScroll">
                            <ItemsControl Name="ReleaseNotesList" Margin="0,0,8,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" Margin="{Binding Margin}"
                                                   FontWeight="{Binding Weight}" FontSize="13"
                                                   LineHeight="18" LineStackingStrategy="BlockLineHeight"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button Grid.Row="2" Name="ReleaseNotesLinkButton" Content="Buka halaman rilis"
                                Click="OnOpenReleasePageClick" Visibility="Collapsed"
                                HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,4"
                                AutomationProperties.AutomationId="UpdateReleaseNotesLink" />
                    </Grid>
                </Border>
                <Border Name="RecoveryPanel" Visibility="Collapsed" Margin="0,12,0,0" Padding="10"
                        BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}"
                        Background="{DynamicResource SurfaceBrush}"
                        AutomationProperties.AutomationId="UpdateRecoveryPanel">
                    <StackPanel>
                        <TextBlock Style="{StaticResource UpdateHelpText}" Name="RecoveryText"
                                   AutomationProperties.AutomationId="UpdateRecoveryText" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Name="RetryRecoveryButton" Content="Pulihkan sekarang"
                                    Click="OnRetryRecoveryClick" Margin="0,0,8,0" Padding="10,4"
                                    AutomationProperties.AutomationId="UpdateRecoveryRetryButton"
                                    ToolTip="Coba pulihkan gambar lock screen lagi. Jurnal pemulihan tidak dihapus." />
                            <Button Name="CancelRecoveryButton" Content="Batal"
                                    Click="OnCancelRecoveryClick" Padding="10,4"
                                    AutomationProperties.AutomationId="UpdateRecoveryCancelButton"
                                    ToolTip="Tutup jendela. Pembaruan belum dipasang dan jurnal pemulihan dibiarkan utuh." />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Name="LaterButton" Content="Nanti saja" Click="OnLaterClick"
                        Visibility="Collapsed" Margin="0,0,8,0" Padding="10,4"
                        AutomationProperties.AutomationId="UpdateLaterButton"
                        ToolTip="Tutup jendela dan ingatkan lagi setelah pemulihan lock screen selesai. Bila tidak ada pemulihan, pengingat muncul 15 menit lagi." />
                <Button Name="IgnoreButton" Content="Abaikan versi ini" Click="OnIgnoreClick"
                        Visibility="Collapsed" Margin="0,0,8,0" Padding="10,4"
                        AutomationProperties.AutomationId="UpdateIgnoreButton"
                        ToolTip="Jangan tawarkan versi ini lagi secara otomatis. Pemeriksaan manual tetap bisa dilakukan." />
                <Button Name="CheckAgainButton" Content="Periksa lagi" Click="OnCheckAgainClick"
                        Margin="0,0,8,0" Padding="10,4"
                        AutomationProperties.AutomationId="UpdateCheckAgainButton" />
                <Button Name="InstallButton" Content="Unduh dan pasang" Click="OnInstallClick"
                        Visibility="Collapsed" Margin="0,0,8,0" Padding="10,4"
                        AutomationProperties.AutomationId="UpdateInstallButton" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
