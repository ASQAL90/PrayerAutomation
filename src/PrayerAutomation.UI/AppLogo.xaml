<UserControl x:Class="PrayerAutomation.UI.AppLogo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PrayerAutomation.UI"
             AutomationProperties.Name="Logo Ayo Jama'ah!" IsHitTestVisible="False">
    <Viewbox Stretch="Uniform">
        <Canvas Width="100" Height="100">
            <Path Data="{DynamicResource BrandBadgeGeometry}" Fill="{DynamicResource BrandBackgroundBrush}" />
            <Path Data="{x:Static local:AppBranding.MosqueGeometry}" Fill="{DynamicResource BrandMosqueBrush}" />
            <Path Data="{x:Static local:AppBranding.CongregationGeometry}" Fill="{DynamicResource BrandCongregationBrush}" />
        </Canvas>
    </Viewbox>
</UserControl>
