<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Architecture is selected with -p:Arch=x64|x86 (default x64). -->
    <Arch Condition="'$(Arch)' == ''">x64</Arch>
    <RuntimeIdentifier Condition="'$(Arch)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Arch)' == 'x86'">win-x86</RuntimeIdentifier>
    <PlatformTarget Condition="'$(Arch)' == 'x64'">x64</PlatformTarget>
    <PlatformTarget Condition="'$(Arch)' == 'x86'">x86</PlatformTarget>
    <RustTarget Condition="'$(Arch)' == 'x64'">x86_64-pc-windows-gnu</RustTarget>
    <RustTarget Condition="'$(Arch)' == 'x86'">i686-pc-windows-gnu</RustTarget>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../AyoJamaah.ico</ApplicationIcon>
    <AssemblyName>AyoJamaah</AssemblyName>
    <Version>2.4.3</Version>
    <Product>Ayo Jama'ah!</Product>
    <Company>Ayo Jama'ah!</Company>
    <AssemblyTitle>Ayo Jama'ah!</AssemblyTitle>
    <Description>Jadwal sholat, kalender, dan pengingat</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Branding/AyoJamaah-v13.svg" />
    <EmbeddedResource Include="../../docs/CHANGELOG.md" Link="CHANGELOG.md"
                      LogicalName="PrayerAutomation.UI.CHANGELOG.md" />
    <PackageReference Include="GeoTimeZone" Version="6.1.0" />
    <PackageReference Include="TimeZoneConverter" Version="7.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../sedang_sholat.png" Link="sedang_sholat.png"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets/AyoJamaah-logo-white.png" Link="AyoJamaah-logo-white.png"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Data/geonames/cities1000.tsv.gz" Link="geonames/cities1000.tsv.gz"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Data/geonames/indonesia.tsv.gz" Link="geonames/indonesia.tsv.gz"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Data/geonames/indonesia.boundary.bin" Link="geonames/indonesia.boundary.bin"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Data/geonames/NOTICE.txt" Link="geonames/NOTICE.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../AyoJamaah.ico" Link="AyoJamaah.ico"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../target/$(RustTarget)/release/prayer_core.dll" Link="prayer_core.dll"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildRustPrayerCore" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="cargo build --release --target $(RustTarget) --package prayer-core"
          WorkingDirectory="$(MSBuildProjectDirectory)/../.." />
  </Target>

  <ItemGroup>
    <Compile Remove="NominatimReverseGeocodingService.cs" />
    <Compile Include="../Shared/PrayerIconPaths.cs" Link="Shared/PrayerIconPaths.cs" />
  </ItemGroup>
</Project>
