<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="SafetyChecks.cs;NativeChecks.cs;BackendChecks.cs" />
    <Compile Include="../../src/PrayerAutomation.UI/LockScreenImageScheduler.cs" Link="Production/LockScreenImageScheduler.cs" />
    <Compile Include="../../src/PrayerAutomation.UI/LockScreenImageWorkflow.cs" Link="Production/LockScreenImageWorkflow.cs" />
    <Compile Include="../../src/PrayerAutomation.UI/LockScreenRestoreStore.cs" Link="Production/LockScreenRestoreStore.cs" />
    <Compile Include="../../src/PrayerAutomation.UI/LockScreenNativePlatform.cs" Link="Production/LockScreenNativePlatform.cs" />
    <Compile Include="../../src/PrayerAutomation.UI/WindowsLockScreenImageBackend.cs" Link="Production/WindowsLockScreenImageBackend.cs" />
    <Compile Include="../../src/PrayerAutomation.UI/LockScreenExecutionRequest.cs" Link="Production/LockScreenExecutionRequest.cs" Condition="Exists('../../src/PrayerAutomation.UI/LockScreenExecutionRequest.cs')" />
    <Compile Include="BaselineLeaseShim.cs" Condition="!Exists('../../src/PrayerAutomation.UI/LockScreenExecutionRequest.cs')" />
  </ItemGroup>
</Project>
